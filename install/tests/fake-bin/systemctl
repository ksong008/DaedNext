#!/bin/sh
if [ -n "${DAED_TEST_CALL_LOG:-}" ]; then
	printf 'systemctl %s\n' "$*" >>"$DAED_TEST_CALL_LOG"
fi

case "${1:-}" in
	show)
		case "${2:-}" in
			--property=Version) exit "${DAED_TEST_BUS_EXIT:-0}" ;;
			--property=ActiveState) printf '%s\n' "${DAED_TEST_ACTIVE_STATE:-active}" ;;
			*) exit 2 ;;
		esac
		;;
	daemon-reload)
		exit 0
		;;
	is-active)
		exit "${DAED_TEST_IS_ACTIVE_EXIT:-0}"
		;;
	restart)
		exit "${DAED_TEST_RESTART_EXIT:-0}"
		;;
	stop)
		exit "${DAED_TEST_STOP_EXIT:-0}"
		;;
	--root=/|disable)
		exit 0
		;;
	status)
		echo "synthetic daed.service status" >&2
		exit 0
		;;
	*)
		echo "unexpected synthetic systemctl operation: ${1:-}" >&2
		exit 2
		;;
esac
