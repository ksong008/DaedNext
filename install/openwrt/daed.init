#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

NAME=daed
PROG="${DAED_PROG:-/usr/bin/daed}"
DEFAULT_CONFIG_DIR=/etc/daed
DEFAULT_LISTEN=0.0.0.0:2023
DEFAULT_WEB_ROOT=/usr/share/daed/web
DEFAULT_LOG_DIR=/tmp/log/daed
DEFAULT_RELOAD_READY_TIMEOUT=2s
DEFAULT_RELOAD_RECOVERY_TIMEOUT=30s
RESOLV_CONF=/tmp/resolv.conf
RESOLV_DAE=/run/daed/resolv.conf
RESOLV_MOUNT_ID=/run/daed/resolv.mount-id
LEGACY_RESOLV_DAE=/tmp/resolv.conf.daed
PACKAGE_RESTART_REQUIRED=/etc/daed/.package-restart-required

load_daed_config() {
	config_load daed

	config_get_bool enabled main enabled 1
	config_get config_dir main config_dir "$DEFAULT_CONFIG_DIR"
	config_get state main state "$config_dir/daed.db"
	config_get listen main listen "$DEFAULT_LISTEN"
	config_get web_root main web_root "$DEFAULT_WEB_ROOT"
	config_get log_dir main log_dir "$DEFAULT_LOG_DIR"
	config_get_bool api_only main api_only 0

	config_get_bool validate_start main validate_start 1
	config_get_bool validate_reload main validate_reload 1
	config_get reload_ready_timeout main reload_ready_timeout "$DEFAULT_RELOAD_READY_TIMEOUT"
	config_get reload_recovery_timeout main reload_recovery_timeout "$DEFAULT_RELOAD_RECOVERY_TIMEOUT"
	config_get term_timeout main term_timeout 10

	config_get_bool respawn main respawn 1
	config_get respawn_threshold main respawn_threshold 3600
	config_get respawn_timeout main respawn_timeout 5
	config_get respawn_retry main respawn_retry 5

	config_get nofile main nofile 1048576
	config_get nproc main nproc 512

	config_get http_profile main http_profile low-memory
	config_get resident_runtime_profile main resident_runtime_profile ""
	config_get http_workers main http_workers ""
	config_get http_queue main http_queue ""
	config_get worker_stack_bytes main worker_stack_bytes ""
}

validate_daed_config() {
	"$PROG" validate -c "$config_dir" --state "$state"
}

validate_daed_runtime_config() {
	"$PROG" validate -c "$config_dir" --state "$state" --runtime
}

resolv_mount_id() {
	# fdinfo identifies the visible mount even when several mounts share the path.
	(
		local path="$1" mount_id
		exec 9<"$path"
		mount_id="$(awk '$1 == "mnt_id:" { print $2 }' /proc/self/fdinfo/9)" || exit 1
		awk -v id="$mount_id" -v path="$path" '$1 == id && $5 == path { print $1 }' /proc/self/mountinfo
	) 2>/dev/null
}

hijack_resolv_conf() {
	local target mount_id resolv_file dns_list dns LOGICAL_WAN
	target="$(readlink -f "$RESOLV_CONF")" || return 1
	mount_id="$(resolv_mount_id "$target")" || return 1
	[ -z "$mount_id" ] || return 0

	resolv_file="$(mktemp /run/daed/resolv.XXXXXX)" || return 1
	# grep returns 1 when there are no search or domain entries.
	grep -E '^(search|domain) ' "$target" >"$resolv_file" || true

	. /lib/functions/network.sh
	network_find_wan LOGICAL_WAN 2>/dev/null
	if [ -n "$LOGICAL_WAN" ]; then
		dns_list=$(ubus call "network.interface.$LOGICAL_WAN" status 2>/dev/null | \
			jsonfilter -e '@["dns-server"][*]' 2>/dev/null)
	fi

	if [ -z "$dns_list" ] && [ -f "/tmp/resolv.conf.d/resolv.conf.auto" ]; then
		dns_list=$(awk '/^nameserver/{print $2}' "/tmp/resolv.conf.d/resolv.conf.auto")
	fi

	[ -z "$dns_list" ] && dns_list="119.29.29.29 223.5.5.5"

	if ! (
		for dns in $dns_list; do
			printf 'nameserver %s\n' "$dns" || exit 1
		done
	) >>"$resolv_file" || ! chmod 0644 "$resolv_file" ||
		! mv -f "$resolv_file" "$RESOLV_DAE"; then
		rm -f "$resolv_file"
		return 1
	fi
	rm -f "$RESOLV_MOUNT_ID" || return 1
	if ! mount --bind "$RESOLV_DAE" "$target"; then
		rm -f "$RESOLV_DAE"
		return 1
	fi
	if mount_id="$(resolv_mount_id "$target")" && [ -n "$mount_id" ] &&
		[ "$RESOLV_DAE" -ef "$target" ] &&
		printf '%s\n' "$mount_id" >"$RESOLV_MOUNT_ID" &&
		mount -o remount,ro,bind "$target"; then
		return 0
	fi
	restore_resolv_conf
	return 1
}

restore_resolv_conf() {
	local target mount_id source recorded_id
	[ -e "$RESOLV_CONF" ] || return 0
	target="$(readlink -f "$RESOLV_CONF")" || return 1
	mount_id="$(resolv_mount_id "$target")" || return 1
	[ -n "$mount_id" ] || return 0

	if [ "$RESOLV_DAE" -ef "$target" ]; then
		source="$RESOLV_DAE"
		if [ -s "$RESOLV_MOUNT_ID" ]; then
			read -r recorded_id <"$RESOLV_MOUNT_ID" || return 1
			[ "$mount_id" = "$recorded_id" ] || return 0
		fi
	elif [ ! -L "$LEGACY_RESOLV_DAE" ] && [ "$LEGACY_RESOLV_DAE" -ef "$target" ]; then
		source="$LEGACY_RESOLV_DAE"
	else
		return 0
	fi

	umount "$target" || return 1
	rm -f "$source" "$RESOLV_MOUNT_ID"
}

start_service() {
	load_daed_config

	[ "$enabled" = "1" ] || {
		echo "daed disabled in /etc/config/daed"
		return 0
	}

	[ -x "$PROG" ] || {
		echo "$PROG not found or not executable"
		return 1
	}

	mkdir -p "$config_dir" "$log_dir" /run/daed
	chmod 700 /run/daed 2>/dev/null || true

	if [ "$validate_start" = "1" ]; then
		validate_daed_config || return 1
	fi

	hijack_resolv_conf || return 1

	procd_open_instance
	procd_set_param command "$PROG" run
	[ "$config_dir" = "$DEFAULT_CONFIG_DIR" ] || procd_append_param command -c "$config_dir"
	[ "$state" = "$config_dir/daed.db" ] || procd_append_param command --state "$state"
	[ "$listen" = "$DEFAULT_LISTEN" ] || procd_append_param command --listen "$listen"
	[ "$web_root" = "$DEFAULT_WEB_ROOT" ] || procd_append_param command --web-root "$web_root"

	if [ "$api_only" = "1" ]; then
		procd_append_param command --api-only
	fi

	procd_set_param env PATH="/usr/sbin:/usr/bin:/sbin:/bin"
	procd_append_param env DAED_PRODUCT_LOG_DIR="$log_dir"
	[ -n "$http_profile" ] && procd_append_param env HTTP_PROFILE="$http_profile"
	[ -n "$resident_runtime_profile" ] && procd_append_param env RESIDENT_RUNTIME_PROFILE="$resident_runtime_profile"
	[ -n "$http_workers" ] && procd_append_param env HTTP_WORKERS="$http_workers"
	[ -n "$http_queue" ] && procd_append_param env HTTP_QUEUE="$http_queue"
	[ -n "$worker_stack_bytes" ] && procd_append_param env HTTP_WORKER_STACK_BYTES="$worker_stack_bytes"

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout "$term_timeout"
	procd_set_param limits nofile="$nofile $nofile" nproc="$nproc $nproc"

	if [ "$respawn" = "1" ]; then
		procd_set_param respawn "$respawn_threshold" "$respawn_timeout" "$respawn_retry"
	fi

	procd_close_instance
}

stop_service() {
	restore_resolv_conf
}

extra_command "package_restart" "Restart daed after a package update or retry a failed restart"
extra_command "package_remove" "Stop daed and disable autostart before package removal"

package_service_info() {
	ubus call service list '{"name":"daed"}'
}

package_stop() {
	local service_info="$1" timeout=10 instance_timeout
	if [ -n "$(jsonfilter -s "$service_info" -e '@.daed')" ]; then
		for instance_timeout in $(jsonfilter -s "$service_info" -e '@.daed.instances[*].term_timeout'); do
			if [ "$instance_timeout" -gt "$timeout" ]; then
				timeout="$instance_timeout"
			fi
		done
		ubus call service delete '{"name":"daed"}' || return 1
		# procd sends SIGTERM asynchronously and retains the PID until exit.
		timeout=$((timeout + 5))
		while :; do
			service_info="$(package_service_info)" || return 1
			[ -n "$(jsonfilter -s "$service_info" -e '@.daed.instances[*].pid')" ] || break
			if [ "$timeout" -eq 0 ]; then
				echo "Timed out waiting for daed to stop." >&2
				return 1
			fi
			sleep 1
			timeout=$((timeout - 1))
		done
	fi
	restore_resolv_conf
}

package_restart() {
	local service_info
	procd_lock
	service_info="$(package_service_info)" || return 1
	if [ ! -e "$PACKAGE_RESTART_REQUIRED" ] &&
		[ -z "$(jsonfilter -s "$service_info" -e '@.daed.instances')" ]; then
		return 0
	fi

	touch "$PACKAGE_RESTART_REQUIRED" || return 1
	if ! package_stop "$service_info" || ! start ||
		! "$PROG" wait-ready --timeout "${DAED_PACKAGE_READY_TIMEOUT:-60s}"; then
		echo "daed package restart failed. Retry with /etc/init.d/daed package_restart." >&2
		return 1
	fi
	rm -f "$PACKAGE_RESTART_REQUIRED" || return 1
	echo "Restarted daed service and verified readiness after package installation."
}

package_remove() {
	local service_info
	procd_lock
	service_info="$(package_service_info)" || return 1
	if ! package_stop "$service_info"; then
		echo "Failed to stop daed or restore its DNS mount before package removal." >&2
		return 1
	fi
	disable || return 1
	rm -f "$PACKAGE_RESTART_REQUIRED"
}

reload_service() {
	load_daed_config

	[ -x "$PROG" ] || {
		echo "$PROG not found or not executable"
		return 1
	}

	if [ "$validate_reload" = "1" ]; then
		validate_daed_runtime_config || return 1
	fi

	hijack_resolv_conf || return 1
	"$PROG" reload && return 0
	local reload_status=$?

	if "$PROG" wait-ready --timeout "$reload_ready_timeout" >/dev/null 2>&1; then
		return "$reload_status"
	fi

	echo "daed reload left the required runtime unavailable; restarting the service"
	restart || return 1
	"$PROG" wait-ready --timeout "$reload_recovery_timeout"
}

service_triggers() {
	procd_add_reload_trigger daed
}
