{
  "name": "@daeuniverse/monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "description": "DaedNext product shell for dae",
  "author": {
    "email": "noreply@github.com",
    "name": "ksong008"
  },
  "license": "MIT",
  "homepage": "https://ksong008.github.io/DaedNext",
  "repository": "https://github.com/ksong008/DaedNext",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:mock": "turbo run build --env-mode=loose -- --mode mock",
    "dev": "turbo run dev",
    "dev:mock": "turbo run dev --env-mode=loose -- --mode mock",
    "test:integration": "node scripts/live_audit.mjs",
    "live-audit": "pnpm test:integration",
    "lint": "eslint --fix .",
    "lint:emoji": "bash ./scripts/check_no_emoji.sh",
    "lint:web-surface": "bash ./scripts/check_retired_frontend_markers.sh",
    "check:protocol-fixtures": "node scripts/check_protocol_fixture_sync.mjs",
    "package:linux:arm64": "bash ./scripts/package_linux_arm64.sh",
    "package:linux:x86_64": "bash ./scripts/package_linux_x86_64.sh",
    "prepare": "husky",
    "screenshot": "pnpm build:mock && npx tsx scripts/screenshot.ts",
    "test": "turbo run test",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "execa": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "simple-git": "catalog:",
    "sort-package-json": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
