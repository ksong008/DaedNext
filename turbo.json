{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.json"],
  "globalPassThroughEnv": ["CI", "VERCEL", "NODE_ENV", "VITE_MOCK_MODE", "SCHEMA_PATH"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputLogs": "new-only",
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "interruptible": true,
      "persistent": true
    },
    "daed#test": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/dae-*/src/**",
        "$TURBO_ROOT$/packages/dae-*/package.json",
        "$TURBO_ROOT$/packages/dae-*/tsconfig*.json"
      ]
    },
    "daed#check-types": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/dae-*/src/**",
        "$TURBO_ROOT$/packages/dae-*/package.json",
        "$TURBO_ROOT$/packages/dae-*/tsconfig*.json"
      ]
    },
    "test": {
      "dependsOn": ["build"]
    }
  }
}
